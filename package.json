{
  "name": "eajmusic-platform",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "cd server && npm run dev",
    "dev:all": "npm run dev:server & npm run dev",
    "start:server": "cd server && npm start",
    "start:all": "npm run start:server & npm run preview",
    "build:main": "cross-env VITE_APP_MODE=main vite build --outDir dist/main",
    "build:artist": "cross-env VITE_APP_MODE=artist vite build --outDir dist/artist",
    "build:eaj": "cross-env VITE_APP_MODE=admin vite build --outDir dist/eaj",
    "build": "npm run build:main && npm run build:artist && npm run build:eaj",
    "preview": "vite preview",
    "install:all": "npm install && cd server && npm install",
    "db:migrate": "cd server && npm run db:migrate",
    "db:seed": "cd server && npm run db:seed"
  },
  "dependencies": {
    "@insforge/sdk": "^1.5.2",
    "framer-motion": "^12.29.2",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-router-dom": "^7.13.0",
    "recharts": "^3.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.5.4",
    "cross-env": "^10.1.0",
    "postcss": "^8.5.24",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
