// ===========================================
// EAJMUSIC - PRISMA SCHEMA
// ===========================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===========================================
// ENUMS
// ===========================================

enum UserRole {
  ARTIST
  LABEL
  ADMIN
  SUPER_ADMIN
}

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
  DELETED
}

enum PlanType {
  FREE
  PRO
  LABEL_PLUS
  ENTERPRISE
}

enum ReleaseType {
  SINGLE
  EP
  ALBUM
  COMPILATION
}

enum ReleaseStatus {
  DRAFT
  PENDING
  APPROVED
  LIVE
  REJECTED
  TAKEDOWN
}

enum TrackStatus {
  PROCESSING
  READY
  ERROR
}

enum PayoutStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum ContributorRole {
  PRIMARY_ARTIST
  FEATURED
  PRODUCER
  SONGWRITER
  COMPOSER
  LYRICIST
  MIXER
  MASTERING
}

// ===========================================
// MODELS
// ===========================================

model User {
  id                String     @id @default(uuid())
  email             String     @unique
  passwordHash      String     @map("password_hash")
  name              String
  role              UserRole   @default(ARTIST)
  status            UserStatus @default(PENDING)
  avatarUrl         String?    @map("avatar_url")
  phone             String?
  countryCode       String?    @map("country_code") @db.Char(2)
  timezone          String     @default("UTC")
  emailVerified     Boolean    @default(false) @map("email_verified")
  emailVerifiedAt   DateTime?  @map("email_verified_at")
  twoFactorEnabled  Boolean    @default(false) @map("two_factor_enabled")
  twoFactorSecret   String?    @map("two_factor_secret")
  lastLoginAt       DateTime?  @map("last_login_at")
  lastLoginIp       String?    @map("last_login_ip")
  createdAt         DateTime   @default(now()) @map("created_at")
  updatedAt         DateTime   @updatedAt @map("updated_at")

  // Relations
  artistProfiles    ArtistProfile[]
  labels            Label[]
  subscription      Subscription?
  releases          Release[]
  wallet            Wallet?
  payouts           Payout[]
  royalties         Royalty[]
  supportTickets    SupportTicket[]
  ticketMessages    SupportTicketMessage[]
  sessions          Session[]
  auditLogs         AuditLog[]
  announcements     Announcement[]
  takedownsResolved TakedownRequest[] @relation("TakedownResolver")
  paymentTransactions PaymentTransaction[]

  @@map("users")
}

model ArtistProfile {
  id            String    @id @default(uuid())
  userId        String    @map("user_id")
  name          String
  bio           String?   @db.Text
  avatarUrl     String?   @map("avatar_url")
  bannerUrl     String?   @map("banner_url")
  spotifyUri    String?   @map("spotify_uri")
  appleMusicId  String?   @map("apple_music_id")
  socialLinks   Json      @default("{}") @map("social_links")
  isVerified    Boolean   @default(false) @map("is_verified")
  verifiedAt    DateTime? @map("verified_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  // Relations
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  releases      Release[]
  contributors  TrackContributor[]

  @@map("artist_profiles")
}

model Label {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  name        String
  logoUrl     String?  @map("logo_url")
  website     String?
  countryCode String?  @map("country_code") @db.Char(2)
  taxId       String?  @map("tax_id")
  createdAt   DateTime @default(now()) @map("created_at")

  // Relations
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  releases    Release[]

  @@map("labels")
}

model Subscription {
  id                   String   @id @default(uuid())
  userId               String   @unique @map("user_id")
  plan                 PlanType @default(FREE)
  pricePaid            Decimal  @default(0) @map("price_paid") @db.Decimal(10, 2)
  commissionRate       Decimal  @default(15.00) @map("commission_rate") @db.Decimal(5, 2)
  maxArtistProfiles    Int      @default(1) @map("max_artist_profiles")
  billingCycle         String   @default("yearly") @map("billing_cycle")
  startsAt             DateTime @default(now()) @map("starts_at")
  expiresAt            DateTime? @map("expires_at")
  stripeSubscriptionId String?  @map("stripe_subscription_id")
  stripeCustomerId     String?  @map("stripe_customer_id")
  isActive             Boolean  @default(true) @map("is_active")
  createdAt            DateTime @default(now()) @map("created_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

model Release {
  id                  String        @id @default(uuid())
  userId              String        @map("user_id")
  artistProfileId     String?       @map("artist_profile_id")
  labelId             String?       @map("label_id")

  // Metadata
  title               String        @db.VarChar(500)
  version             String?       @db.VarChar(100)
  releaseType         ReleaseType   @map("release_type")
  genre               String        @db.VarChar(100)
  subgenre            String?       @db.VarChar(100)
  language            String        @default("EN") @db.Char(2)

  // Identifiers
  upc                 String?       @unique @db.VarChar(13)
  catalogNumber       String?       @map("catalog_number") @db.VarChar(50)

  // Dates
  releaseDate         DateTime      @map("release_date") @db.Date
  originalReleaseDate DateTime?     @map("original_release_date") @db.Date
  submittedAt         DateTime?     @map("submitted_at")
  approvedAt          DateTime?     @map("approved_at")

  // Artwork
  coverArtUrl         String?       @map("cover_art_url")
  coverArtKey         String?       @map("cover_art_key") @db.VarChar(500)

  // Rights
  cLineYear           Int?          @map("c_line_year")
  cLineText           String?       @map("c_line_text") @db.VarChar(255)
  pLineYear           Int?          @map("p_line_year")
  pLineText           String?       @map("p_line_text") @db.VarChar(255)

  // Status
  status              ReleaseStatus @default(DRAFT)
  rejectionReason     String?       @map("rejection_reason") @db.Text
  isExplicit          Boolean       @default(false) @map("is_explicit")

  // Distribution
  selectedStores      Json          @default("[\"all\"]") @map("selected_stores")
  territories         Json          @default("[\"worldwide\"]")

  // Timestamps
  createdAt           DateTime      @default(now()) @map("created_at")
  updatedAt           DateTime      @updatedAt @map("updated_at")

  // Relations
  user                User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  artistProfile       ArtistProfile?    @relation(fields: [artistProfileId], references: [id])
  label               Label?            @relation(fields: [labelId], references: [id])
  tracks              Track[]
  royalties           Royalty[]
  takedownRequests    TakedownRequest[]

  @@index([userId])
  @@index([status])
  @@index([releaseDate])
  @@map("releases")
}

model Track {
  id              String      @id @default(uuid())
  releaseId       String      @map("release_id")

  // Metadata
  title           String      @db.VarChar(500)
  version         String?     @db.VarChar(100)
  trackNumber     Int         @map("track_number")
  discNumber      Int         @default(1) @map("disc_number")
  durationMs      Int?        @map("duration_ms")

  // Identifiers
  isrc            String?     @unique @db.Char(12)

  // Files
  audioUrl        String?     @map("audio_url")
  audioKey        String?     @map("audio_key") @db.VarChar(500)
  audioFormat     String?     @map("audio_format") @db.VarChar(20)
  audioBitrate    Int?        @map("audio_bitrate")
  audioSampleRate Int?        @map("audio_sample_rate")
  waveformData    Json?       @map("waveform_data")

  // Additional metadata
  bpm             Int?
  keySignature    String?     @map("key_signature") @db.VarChar(10)
  isExplicit      Boolean     @default(false) @map("is_explicit")
  lyrics          String?     @db.Text
  lyricsLanguage  String?     @map("lyrics_language") @db.Char(2)

  // Preview
  previewStartMs  Int         @default(30000) @map("preview_start_ms")
  previewUrl      String?     @map("preview_url")

  // Status
  status          TrackStatus @default(PROCESSING)
  processingError String?     @map("processing_error") @db.Text

  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  // Relations
  release         Release            @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  contributors    TrackContributor[]
  streamingStats  StreamingStat[]
  royalties       Royalty[]

  @@index([releaseId])
  @@map("tracks")
}

model TrackContributor {
  id               String          @id @default(uuid())
  trackId          String          @map("track_id")
  artistProfileId  String?         @map("artist_profile_id")
  name             String          @db.VarChar(255)
  role             ContributorRole
  royaltyPercentage Decimal        @default(0) @map("royalty_percentage") @db.Decimal(5, 2)
  ipiNumber        String?         @map("ipi_number") @db.VarChar(20)
  createdAt        DateTime        @default(now()) @map("created_at")

  // Relations
  track            Track          @relation(fields: [trackId], references: [id], onDelete: Cascade)
  artistProfile    ArtistProfile? @relation(fields: [artistProfileId], references: [id])

  @@map("track_contributors")
}

model DSP {
  id            String          @id @default(uuid())
  name          String          @db.VarChar(100)
  code          String          @unique @db.VarChar(50)
  logoUrl       String?         @map("logo_url")
  ratePerStream Decimal?        @map("rate_per_stream") @db.Decimal(10, 6)
  isActive      Boolean         @default(true) @map("is_active")

  // Relations
  streamingStats StreamingStat[]
  royalties      Royalty[]

  @@map("dsps")
}

model StreamingStat {
  id           String   @id @default(uuid())
  trackId      String   @map("track_id")
  dspId        String   @map("dsp_id")
  date         DateTime @db.Date
  countryCode  String?  @map("country_code") @db.Char(2)
  streams      BigInt   @default(0)
  saves        BigInt   @default(0)
  playlistAdds BigInt   @default(0) @map("playlist_adds")
  revenueGross Decimal  @default(0) @map("revenue_gross") @db.Decimal(12, 4)
  revenueNet   Decimal  @default(0) @map("revenue_net") @db.Decimal(12, 4)
  createdAt    DateTime @default(now()) @map("created_at")

  // Relations
  track Track @relation(fields: [trackId], references: [id], onDelete: Cascade)
  dsp   DSP   @relation(fields: [dspId], references: [id])

  @@unique([trackId, dspId, date, countryCode])
  @@index([trackId, date])
  @@map("streaming_stats")
}

model Royalty {
  id               String   @id @default(uuid())
  userId           String   @map("user_id")
  releaseId        String?  @map("release_id")
  trackId          String?  @map("track_id")
  dspId            String?  @map("dsp_id")
  periodStart      DateTime @map("period_start") @db.Date
  periodEnd        DateTime @map("period_end") @db.Date
  streams          BigInt   @default(0)
  grossRevenue     Decimal  @map("gross_revenue") @db.Decimal(12, 4)
  commissionAmount Decimal  @map("commission_amount") @db.Decimal(12, 4)
  netRevenue       Decimal  @map("net_revenue") @db.Decimal(12, 4)
  currency         String   @default("USD") @db.Char(3)
  exchangeRate     Decimal  @default(1) @map("exchange_rate") @db.Decimal(12, 6)
  status           String   @default("pending") @db.VarChar(20)
  processedAt      DateTime? @map("processed_at")
  createdAt        DateTime @default(now()) @map("created_at")

  // Relations
  user    User     @relation(fields: [userId], references: [id])
  release Release? @relation(fields: [releaseId], references: [id])
  track   Track?   @relation(fields: [trackId], references: [id])
  dsp     DSP?     @relation(fields: [dspId], references: [id])

  @@index([userId, periodStart, periodEnd])
  @@map("royalties")
}

model Wallet {
  id                 String   @id @default(uuid())
  userId             String   @unique @map("user_id")
  availableBalance   Decimal  @default(0) @map("available_balance") @db.Decimal(12, 2)
  pendingBalance     Decimal  @default(0) @map("pending_balance") @db.Decimal(12, 2)
  lifetimeEarnings   Decimal  @default(0) @map("lifetime_earnings") @db.Decimal(12, 2)
  currency           String   @default("USD") @db.Char(3)
  minPayoutThreshold Decimal  @default(50.00) @map("min_payout_threshold") @db.Decimal(10, 2)
  updatedAt          DateTime @updatedAt @map("updated_at")

  // Relations
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  payouts Payout[]

  @@map("wallets")
}

model Payout {
  id            String       @id @default(uuid())
  userId        String       @map("user_id")
  walletId      String       @map("wallet_id")
  amount        Decimal      @db.Decimal(12, 2)
  currency      String       @default("USD") @db.Char(3)
  method        String       @db.VarChar(50)
  methodDetails Json         @map("method_details")
  status        PayoutStatus @default(PENDING)
  processedAt   DateTime?    @map("processed_at")
  transactionId String?      @map("transaction_id") @db.VarChar(255)
  failureReason String?      @map("failure_reason") @db.Text
  requestedAt   DateTime     @default(now()) @map("requested_at")

  // Relations
  user   User   @relation(fields: [userId], references: [id])
  wallet Wallet @relation(fields: [walletId], references: [id])

  @@map("payouts")
}

model SupportTicket {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  subject     String
  category    String   @default("General")
  priority    String   @default("normal")
  status      String   @default("OPEN")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])
  messages SupportTicketMessage[]

  @@map("support_tickets")
}

model SupportTicketMessage {
  id          String   @id @default(uuid())
  ticketId    String   @map("ticket_id")
  userId      String   @map("user_id")
  message     String   @db.Text
  isInternal  Boolean  @default(false) @map("is_internal")
  createdAt   DateTime @default(now()) @map("created_at")

  ticket SupportTicket @relation(fields: [ticketId], references: [id])
  user   User          @relation(fields: [userId], references: [id])

  @@map("support_ticket_messages")
}

model NewsletterSubscriber {
  id        String   @id @default(uuid())
  email     String   @unique
  status    String   @default("SUBSCRIBED")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("newsletter_subscribers")
}

model ContactMessage {
  id        String   @id @default(uuid())
  name      String
  email     String
  message   String   @db.Text
  status    String   @default("UNREAD")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("contact_messages")
}

model Announcement {
  id             String    @id @default(uuid())
  title          String    @db.VarChar(500)
  content        String    @db.Text
  type           String    @default("info") @db.VarChar(50)
  targetAudience String    @default("all") @map("target_audience") @db.VarChar(50)
  isActive       Boolean   @default(true) @map("is_active")
  startsAt       DateTime  @default(now()) @map("starts_at")
  expiresAt      DateTime? @map("expires_at")
  createdBy      String    @map("created_by")
  createdAt      DateTime  @default(now()) @map("created_at")

  // Relations
  author User @relation(fields: [createdBy], references: [id])

  @@map("announcements")
}

model TakedownRequest {
  id               String    @id @default(uuid())
  releaseId        String    @map("release_id")
  requesterName    String    @map("requester_name") @db.VarChar(255)
  requesterEmail   String    @map("requester_email") @db.VarChar(255)
  requesterCompany String?   @map("requester_company") @db.VarChar(255)
  reason           String    @db.VarChar(100)
  details          String?   @db.Text
  evidenceUrls     Json      @default("[]") @map("evidence_urls")
  status           String    @default("pending") @db.VarChar(50)
  resolution       String?   @db.Text
  resolvedBy       String?   @map("resolved_by")
  resolvedAt       DateTime? @map("resolved_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  // Relations
  release  Release @relation(fields: [releaseId], references: [id])
  resolver User?   @relation("TakedownResolver", fields: [resolvedBy], references: [id])

  @@map("takedown_requests")
}

model Session {
  id             String   @id @default(uuid())
  userId         String   @map("user_id")
  tokenHash      String   @map("token_hash") @db.VarChar(255)
  refreshToken   String?  @map("refresh_token") @db.VarChar(255)
  ipAddress      String?  @map("ip_address")
  userAgent      String?  @map("user_agent") @db.Text
  expiresAt      DateTime @map("expires_at")
  createdAt      DateTime @default(now()) @map("created_at")
  lastActivityAt DateTime @default(now()) @map("last_activity_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
  @@index([expiresAt])
  @@map("sessions")
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?  @map("user_id")
  action     String   @db.VarChar(100)
  entityType String?  @map("entity_type") @db.VarChar(100)
  entityId   String?  @map("entity_id")
  oldValues  Json?    @map("old_values")
  newValues  Json?    @map("new_values")
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent") @db.Text
  createdAt  DateTime @default(now()) @map("created_at")

  // Relations
  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

model PlatformSetting {
  key         String   @id @db.VarChar(100)
  value       Json
  description String?  @db.Text
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("platform_settings")
}

enum PaymentProvider {
  ATH_MOVIL
  PAYPAL
  BANK_TRANSFER
  STRIPE
  WISE
}

enum PaymentStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REFUNDED
  EXPIRED
}

model PaymentTransaction {
  id          String          @id @default(uuid())
  userId      String          @map("user_id")
  provider    PaymentProvider
  externalId  String?         @map("external_id") @db.VarChar(255)
  amount      Decimal         @db.Decimal(12, 2)
  currency    String          @default("USD") @db.Char(3)
  status      PaymentStatus   @default(PENDING)
  type        String          @default("subscription") @db.VarChar(50)
  metadata    Json            @default("{}")
  completedAt DateTime?       @map("completed_at")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  // Relations
  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([provider, status])
  @@index([externalId])
  @@map("payment_transactions")
}
