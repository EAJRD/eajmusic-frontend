# ===========================================
# EAJMUSIC BACKEND - ENVIRONMENT VARIABLES
# ===========================================
# Copy this file to .env and fill in your values

# Server
NODE_ENV=development
PORT=5001

# Database (PostgreSQL en tu servidor Proxmox)
# Formato: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://eajmusic_user:TU_PASSWORD_SEGURO@tu-ip-publica-o-dominio:5432/eajmusic_db?schema=public"

# JWT Authentication
JWT_SECRET="genera-un-secret-muy-largo-y-seguro-aqui-minimo-64-caracteres"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_EXPIRES_IN="30d"

# Bcrypt
BCRYPT_ROUNDS=12

# File Upload (Hostinger o servicio externo)
# Opción 1: Local storage en Hostinger
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE=52428800

# Opción 2: AWS S3 / DigitalOcean Spaces / Backblaze B2
# S3_ENDPOINT="https://tu-endpoint.com"
# S3_BUCKET="eajmusic-files"
# S3_ACCESS_KEY="tu-access-key"
# S3_SECRET_KEY="tu-secret-key"
# S3_REGION="us-east-1"

# URLs (actualiza con tus dominios)
FRONTEND_URL="https://eajmusic.com"
API_URL="https://api.eajmusic.com"

# Email (SendGrid, Mailgun, o SMTP)
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT=465
SMTP_USER="noreply@eajmusic.com"
SMTP_PASS="tu-password-smtp"
EMAIL_FROM="EAJMUSIC <noreply@eajmusic.com>"

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# CORS (dominios permitidos, separados por coma)
CORS_ORIGINS="https://eajmusic.com,https://www.eajmusic.com,https://artist.eajmusic.com,https://eaj.eajmusic.com,http://localhost:3000"
