# Vite loads this automatically on `npm run build` (mode defaults to "production").
# Committed on purpose: this is a public URL, not a secret - it ends up visible
# in the built JS bundle regardless of how it's supplied. Without this file,
# any build pipeline that clones from GitHub (no local .env) silently falls back
# to the http://localhost:5001/api default in src/services/api.ts, which breaks
# every API call (register, login, etc.) in production.
VITE_API_URL=https://api.eajmusic.com/api
