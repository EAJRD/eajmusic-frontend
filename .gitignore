# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Environment files - never commit real secrets, only .env.example
# Exception: .env.production only holds the PUBLIC API URL (no secrets) so that
# any build pipeline (e.g. Hostinger auto-deploy from GitHub) bakes the right
# backend URL into the Vite bundle even without manual env var configuration.
.env
.env.*
!.env.example
!.env.production
server/.env
server/.env.*
!server/.env.example

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
