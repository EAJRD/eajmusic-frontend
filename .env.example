# ===========================================
# EAJMUSIC FRONTEND - ENVIRONMENT VARIABLES
# ===========================================
# Copy this file to .env and fill in your values

# Primary API URL (Proxmox via Cloudflare Tunnel)
VITE_API_URL=https://api.eajmusic.com/api

# Fallback Database (Supabase - for high availability)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Failover Configuration
VITE_DB_TIMEOUT_MS=3000
VITE_HEALTH_CHECK_INTERVAL_MS=30000

# For local development:
# VITE_API_URL=http://localhost:5001/api
