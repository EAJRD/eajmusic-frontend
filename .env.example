# ===========================================
# EAJMUSIC FRONTEND - ENVIRONMENT VARIABLES
# ===========================================
# Copy this file to .env and fill in your values

# Primary API URL (Proxmox via Cloudflare Tunnel)
VITE_API_URL=https://api-api.eajmusic.com/api

# InsForge (https://insforge.dev) - auth front door (signup/login/OAuth/
# email verification/password reset). Get with:
#   npx @insforge/cli secrets get ANON_KEY
#   (URL is the oss_host in .insforge/project.json)
VITE_INSFORGE_URL=https://ayp7537q.us-east.insforge.app
VITE_INSFORGE_ANON_KEY=your-anon-key-here

# For local development:
# VITE_API_URL=http://localhost:5001/api
